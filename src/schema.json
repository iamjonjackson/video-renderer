{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Video Spec",
  "type": "object",
  "required": ["timeline"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "resolution": {
          "type": "object",
          "properties": {
            "width": { "type": "integer", "default": 1920 },
            "height": { "type": "integer", "default": 1080 }
          }
        },
        "fps": { "type": "integer", "default": 30 }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "preset": { "type": "string", "enum": ["dark", "light"], "default": "dark" },
        "color_scheme": { "enum": ["red", "orange", "yellow", "green", "blue", "purple", "pink", "white", "grey"], "description": "Whole-video colours for backgrounds, panels, text, charts and generated branding; takes precedence over preset" },
        "surface": { "type": "string", "description": "Panel and caption background, hex" },
        "secondary": { "type": "string", "description": "Secondary accent, hex" },
        "chart_colors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "chart_text": { "type": "string", "description": "Text inside pie slices, hex" },
        "bg": { "type": "string", "description": "Background color, hex like #0d1117" },
        "fg": { "type": "string", "description": "Foreground/text color, hex" },
        "accent": { "type": "string", "description": "Accent color, hex" },
        "font_size": { "type": "integer", "default": 64 },
        "title_font_size": { "type": "integer", "default": 96 }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "type": "string",
          "minLength": 1,
          "description": "Image path relative to the spec file; PNG alpha is preserved"
        },
        "position": {
          "enum": [
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right"
          ],
          "default": "bottom-right"
        },
        "margin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5,
          "default": 0.03,
          "description": "Inset as a fraction of each frame dimension, rounded to pixels (minimum 1px)"
        },
        "max_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "Maximum logo height as a fraction of frame height; aspect ratio preserved, no upscaling, also constrained to the inset canvas"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.85
        },
        "scenes": {
          "default": "all",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "title",
                  "bullets",
                  "image",
                  "chart",
                  "outro"
                ]
              }
            }
          ]
        },
        "generated": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
            },
            "tagline": {
              "type": "string",
              "maxLength": 48,
              "pattern": "^[^\\r\\n]*$"
            },
            "style": {
              "enum": [
                "orbit",
                "spark",
                "petal"
              ],
              "default": "orbit"
            },
            "palette": {
              "enum": ["red", "orange", "yellow", "green", "blue", "purple", "pink", "white", "grey"],
              "description": "Optional logo-only override; otherwise inherits theme.color_scheme, or blue if no scheme is set"
            },
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "logo"
          ]
        },
        {
          "required": [
            "generated"
          ]
        }
      ]
    },
    "voice": {
      "type": "object",
      "properties": {
        "slug": { "type": "string", "description": "Mistral TTS voice slug, e.g. en_jane_neutral" },
        "voice_id": { "type": "string", "description": "Mistral TTS cloned voice UUID (overrides slug)" },
        "model": { "type": "string", "default": "voxtral-mini-tts-2603" },
        "format": { "type": "string", "enum": ["mp3", "wav"], "default": "mp3" }
      }
    },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/definitions/scene" }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/definitions/title" },
        { "$ref": "#/definitions/bullets" },
        { "$ref": "#/definitions/image" },
        { "$ref": "#/definitions/chart" },
        { "$ref": "#/definitions/outro" }
      ],
      "properties": {
        "transition": {
          "type": "string",
          "enum": ["none", "fade", "slide-left", "wipe"],
          "description": "Transition into the next scene"
        }
      }
    },
    "title": {
      "properties": {
        "type": { "const": "title" },
        "text": { "type": "string" },
        "subtitle": { "type": "string" },
        "anim": { "enum": ["fade", "slide-up", "zoom-in"], "default": "fade" },
        "duration": { "type": "number", "description": "Explicit duration in seconds; omit for audio-driven" },
        "narration": { "type": "string", "description": "TTS text; scene auto-sizes to audio length + padding" },
        "padding": { "type": "number", "default": 1.0, "description": "Extra seconds after narration ends (minimum tail buffer)" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "bullets": {
      "properties": {
        "type": { "const": "bullets" },
        "heading": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "stagger": { "type": "number", "default": 0.4, "description": "Seconds between bullet reveals" },
        "narration": { "type": "string" },
        "narration_per_bullet": { "type": "array", "items": { "type": "string" }, "description": "One TTS clip per bullet, each bullet reveals as its audio starts" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "items"],
      "additionalProperties": false
    },
    "image": {
      "properties": {
        "type": { "const": "image" },
        "src": { "type": "string", "description": "Local path or URL to image" },
        "caption": { "type": "string" },
        "anim": { "enum": ["fade", "kenburns"], "default": "fade" },
        "narration": { "type": "string" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "src"],
      "additionalProperties": false
    },
    "chart": {
      "properties": {
        "type": { "const": "chart" },
        "chart_type": { "enum": ["bar", "line", "pie"], "default": "bar" },
        "heading": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "array", "items": { "type": "number" } },
        "y_label": { "type": "string" },
        "narration": { "type": "string" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "labels", "values"],
      "additionalProperties": false
    },
    "outro": {
      "properties": {
        "type": { "const": "outro" },
        "text": { "type": "string" },
        "narration": { "type": "string" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    }
  }
}
