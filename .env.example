# mistral api key for the default narration provider and ai images
# get one at https://console.mistral.ai/ and keep the real env file private
MISTRAL_API_KEY=

# narration provider can be mistral, google or elevenlabs
TTS_PROVIDER=mistral

# google ai studio key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# elevenlabs key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# optional explicit voice id skips the account voice lookup
# ELEVENLABS_VOICE_ID=

# Optional: image generation model for scene 'image' blocks
# IMAGE_MODEL=flux-schnell
