# Mistral API key — used for TTS narration and AI image generation.
# Get one at https://console.mistral.ai/  (never commit the real .env)
MISTRAL_API_KEY=

# Optional: override the TTS voice (built-in British default: gb_jane_neutral)
# MISTRAL_VOICE=gb_jane_neutral

# Optional: image generation model for scene 'image' blocks
# IMAGE_MODEL=flux-schnell
