# Mistral API key — TTS + image generation. https://console.mistral.ai/
MISTRAL_API_KEY=

# TTS provider: mistral (default) | google | elevenlabs | fal
# TTS_PROVIDER=mistral

# Google AI Studio (Gemini TTS): https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# ElevenLabs (free: 10k credits/mo, non-commercial + attribution, MP3;
# library voices need a paid plan): https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# fal.ai: https://fal.ai/dashboard/keys
# FAL_KEY=
# FAL_ENDPOINT=fal-ai/elevenlabs/tts/eleven-v3

# Optional voice overrides (spec voice.* wins)
# MISTRAL_VOICE=gb_jane_neutral
# GOOGLE_VOICE=Kore
# FAL_VOICE=Rachel

# IMAGE_MODEL=flux-schnell
