# Server-side credentials only. Never commit the real .env or send keys to Studio.
# Mistral: hosted text, strict narration, legacy CLI TTS/agent images.
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=
# Google: hosted text/vision, optional concept image, strict/CLI narration.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Alternative Google key name (used when GOOGLE_API_KEY is unset).
# GEMINI_API_KEY=
# ElevenLabs: narration only, not storyboard/image generation.
ELEVENLABS_API_KEY=

# Studio hosted text: no implicit model. Set an exact model supported by your
# account and structured-output API. Optional critique also needs vision support.
# Configuration readiness does not verify availability, free tier or price.
FRAME_GOOGLE_MODEL=
FRAME_MISTRAL_MODEL=
# Optional Google concept image stage; explicit per-job consent required.
FRAME_GOOGLE_IMAGE_MODEL=
# Hosted jobs: 2–5 calls, <=16384 output tokens per structured call; no monetary cap.

# Studio strict narrated export: all three settings required, exact identity,
# separate consent, up to 12 requests. No retries or provider/model/voice fallback.
# Provider must be google, mistral or elevenlabs; model/voice are account-specific.
FRAME_TTS_PROVIDER=
FRAME_TTS_MODEL=
FRAME_TTS_VOICE=

# Legacy CLI narration is separate and may fall back or skip failed synthesis.
# TTS_PROVIDER=mistral
# Mistral CLI voice/model are selected in spec meta.tts / voice fields.
# GOOGLE_TTS_MODEL=
# GOOGLE_TTS_VOICE=Kore
# GOOGLE_TTS_STYLE=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=
# Legacy CLI image agent model is selected in the scene image.model field,
# not an environment variable; it is separate from FRAME_GOOGLE_IMAGE_MODEL.
