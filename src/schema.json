{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Video Spec",
  "type": "object",
  "required": ["timeline"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "resolution": {
          "type": "object",
          "properties": {
            "width": { "type": "integer", "default": 1920 },
            "height": { "type": "integer", "default": 1080 }
          }
        },
        "fps": { "type": "integer", "default": 30 },
        "tts": {
          "type": "object",
          "description": "Narration provider defaults; matching voice.* keys win",
          "properties": {
            "provider": { "type": "string", "enum": ["mistral", "google", "elevenlabs", "fal"], "default": "mistral" },
            "style": { "type": "string", "description": "Style prompt (Google speech_metadata / fal Gemini style_instructions)" },
            "strict": { "type": "boolean", "default": false, "description": "Disable voice defaults/fallbacks; fail if no explicit voice or it is rejected" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "preset": { "type": "string", "enum": ["dark", "light"], "default": "dark" },
        "bg": { "type": "string", "description": "Background color, hex like #0d1117" },
        "fg": { "type": "string", "description": "Foreground/text color, hex" },
        "accent": { "type": "string", "description": "Accent color, hex" },
        "font_size": { "type": "integer", "default": 64 },
        "title_font_size": { "type": "integer", "default": 96 }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["mistral", "google", "elevenlabs", "fal"], "description": "Overrides meta.tts.provider and TTS_PROVIDER" },
        "slug": { "type": "string", "description": "Provider voice name/slug (Mistral slug, Google voice like Kore, ElevenLabs voice ID)" },
        "name": { "type": "string", "description": "Alias for slug" },
        "voice_id": { "type": "string", "description": "Provider voice ID (Mistral cloned UUID / ElevenLabs voice ID); overrides slug" },
        "model": { "type": "string", "description": "Provider model; Google e.g. gemini-3.8-flash-tts; for fal this is the endpoint ID (e.g. fal-ai/elevenlabs/tts/eleven-v3)" },
        "style": { "type": "string", "description": "Style prompt (Google speech_metadata / fal Gemini)" },
        "strict": { "type": "boolean", "description": "Overrides meta.tts.strict; fail instead of using a default/fallback voice" },
        "format": { "type": "string", "enum": ["mp3", "wav"], "default": "mp3", "description": "Requested format; providers may normalise (Google always WAV, ElevenLabs defaults to MP3, fal often MP3)" }
      }
    },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/definitions/scene" }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/definitions/title" },
        { "$ref": "#/definitions/bullets" },
        { "$ref": "#/definitions/image" },
        { "$ref": "#/definitions/chart" },
        { "$ref": "#/definitions/outro" }
      ],
      "properties": {
        "transition": {
          "type": "string",
          "enum": ["none", "fade", "slide-left", "wipe"],
          "description": "Transition into the next scene"
        }
      }
    },
    "title": {
      "properties": {
        "type": { "const": "title" },
        "text": { "type": "string" },
        "subtitle": { "type": "string" },
        "anim": { "enum": ["fade", "slide-up", "zoom-in"], "default": "fade" },
        "duration": { "type": "number", "description": "Explicit duration in seconds; omit for audio-driven" },
        "narration": { "type": "string", "description": "TTS text; scene auto-sizes to audio length + padding" },
        "padding": { "type": "number", "default": 1.0, "description": "Extra seconds after narration ends (minimum tail buffer)" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "bullets": {
      "properties": {
        "type": { "const": "bullets" },
        "heading": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "stagger": { "type": "number", "default": 0.4, "description": "Seconds between bullet reveals" },
        "narration": { "type": "string" },
        "narration_per_bullet": { "type": "array", "items": { "type": "string" }, "description": "One TTS clip per bullet, each bullet reveals as its audio starts" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "items"],
      "additionalProperties": false
    },
    "image": {
      "properties": {
        "type": { "const": "image" },
        "src": { "type": "string", "description": "Local path or URL to image" },
        "caption": { "type": "string" },
        "anim": { "enum": ["fade", "kenburns"], "default": "fade" },
        "narration": { "type": "string" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "src"],
      "additionalProperties": false
    },
    "chart": {
      "properties": {
        "type": { "const": "chart" },
        "chart_type": { "enum": ["bar", "line", "pie"], "default": "bar" },
        "heading": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "array", "items": { "type": "number" } },
        "y_label": { "type": "string" },
        "narration": { "type": "string" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "labels", "values"],
      "additionalProperties": false
    },
    "outro": {
      "properties": {
        "type": { "const": "outro" },
        "text": { "type": "string" },
        "narration": { "type": "string" },
        "duration": { "type": "number" },
        "padding": { "type": "number", "default": 1.0 },
        "transition": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    }
  }
}
